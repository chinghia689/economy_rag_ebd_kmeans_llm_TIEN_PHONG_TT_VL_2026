# Production example for vietecochat.site.
# Copy to .env on the server and fill secret values. Do not commit .env.

ENV=production
PORT=8001
DEFAULT_LLM=openai
ALLOW_ORIGINS=https://vietecochat.site,https://www.vietecochat.site
NAME_WEB=vietecochat

# LLM providers
KEY_API_OPENAI=
OPENAI_LLM_MODEL_NAME=gpt-5-mini
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL_NAME=gemini-2.5-flash
GROQ_API_KEY=
GROQ_LLM_MODEL_NAME=llama-3.1-8b-instant

# JWT
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://vietecochat.site/api/v1/auth/google/callback/flutter

# Payment: SePay and VietQR
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=
BANK_CODE=MB
BANK_NAME=MB Bank
BANK_ACCOUNT_NAME=

# Root admin bootstrap. This seeds SQLite only when the setting is empty.
ADMIN_LOGIN_EMAIL=admin@local
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-password
