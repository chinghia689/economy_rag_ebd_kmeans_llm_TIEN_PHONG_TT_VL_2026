# System
ENV=production
DEFAULT_LLM=openai
ALLOW_ORIGINS=http://localhost:5173,http://localhost:8001
NAME_WEB=KTChatbot

# LLM providers
KEY_API_OPENAI=
OPENAI_LLM_MODEL_NAME=gpt-4o-mini
