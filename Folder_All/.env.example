# JWT
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback/flutter

# Payment: SePay and VietQR
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=
